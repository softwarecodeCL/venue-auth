ENV='dev'
API_DEV_URL='http://localhost:3010'
API_PROD_URL='http://localhost:3010'
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=50m
PORT=3010
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
CALLBACK_GOOGLE=http://localhost:3010/auth/google/callback
##########################################################
NODE_ENV=development

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGINS=http://localhost:3000

# Leave blank for localhost. Example in production: .apartha.com
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

SMS_PROVIDER=aws
PHONE_DEFAULT_COUNTRY=CL
PHONE_ALLOWED_COUNTRIES=CL
PHONE_OTP_SECRET=replace-with-a-long-random-secret-different-from-jwt
PHONE_OTP_EXPIRES_MINUTES=10
PHONE_OTP_RESEND_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_SENDS_PER_HOUR=5

AWS_REGION=us-east-1
AWS_SMS_POOL_ID=
AWS_SMS_PROTECT_CONFIGURATION_ID=
AWS_SMS_CONFIGURATION_SET=APARTHA-OTP

# Optional. Configure it only after confirming support/registration for the destination country.
AWS_SNS_SENDER_ID=


# SMS provider: console | aws
SMS_PROVIDER=aws